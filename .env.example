# Optional. Defaults to ~/.webot
WEBOT_STATE_DIR=/absolute/path/to/private/state

# Optional protocol overrides for development only.
WEBOT_API_BASE_URL=https://ilinkai.weixin.qq.com
WEBOT_BOT_TYPE=3

# Choose echo, openai, cliproxy, deepseek, or an ID from ~/.webot/providers.json.
WEBOT_DEFAULT_PROVIDER=echo

# Local visual admin. It binds to 127.0.0.1 only.
WEBOT_ADMIN_ENABLED=true
WEBOT_ADMIN_PORT=3210

# Prompt input budget uses a conservative local token estimate. The admin keeps
# only the latest N private traces per Agent and loads their bodies on demand.
WEBOT_PROMPT_BUDGET_TOKENS=24000
WEBOT_PROMPT_TRACE_RETENTION=20
# Consecutive normal messages from one user are combined after 1500 ms of
# silence, with a 5000 ms maximum collection window. Slash commands bypass it.
WEBOT_MESSAGE_DEBOUNCE_MS=1500
WEBOT_MESSAGE_MAX_WAIT_MS=5000
# After the first bubble, wait 800 ms + 120 ms per visible character in the
# next bubble, clamped to 1000-7000 ms. WEBOT_BUBBLE_DELAY_MS remains a legacy alias
# for WEBOT_BUBBLE_BASE_DELAY_MS.
WEBOT_BUBBLE_BASE_DELAY_MS=800
WEBOT_BUBBLE_MS_PER_CHARACTER=120
WEBOT_BUBBLE_MIN_DELAY_MS=1000
WEBOT_BUBBLE_MAX_DELAY_MS=7000

# LLM memory curation. Values are message counts and must be even.
# After 40 working messages, older messages are compressed while 20 stay verbatim.
WEBOT_MEMORY_COMPRESSION_THRESHOLD=40
WEBOT_MEMORY_RETAIN_MESSAGES=20

# Agent autonomous life. Disabled by default; users can enable the active Agent
# with /life on. After 6 idle hours, one new off-screen memory may be generated
# every 6 hours. iLink proactive delivery is best-effort and capped per day.
WEBOT_AUTONOMY_DEFAULT_ENABLED=false
WEBOT_AUTONOMY_IDLE_HOURS=6
WEBOT_AUTONOMY_INTERVAL_HOURS=6
WEBOT_AUTONOMY_MAX_CONTACTS_PER_DAY=1
WEBOT_AUTONOMY_TIME_ZONE=Asia/Shanghai

# Autonomous contact, daily weather, and reminders require a recent iLink
# context token. Daily weather is configured per Agent in the admin and starts
# disabled.
WEBOT_CONTEXT_TOKEN_MAX_AGE_HOURS=24
WEBOT_WEATHER_CATCH_UP_MINUTES=180
WEBOT_REMINDER_CATCH_UP_HOURS=24

# Never commit real keys. WeBot loads .env automatically when it exists.
OPENAI_API_KEY=
CLIPROXY_API_KEY=
DEEPSEEK_API_KEY=
CUSTOM_API_KEY=

# Optional independent media routing. Defaults shown below. The cliproxy URL
# is built in as http://127.0.0.1:8317/v1; loopback means the machine running
# WeBot, not the browser used to open the admin console.
WEBOT_VISION_PROVIDER=cliproxy
WEBOT_VISION_MODEL=gpt-5.6-sol
WEBOT_IMAGE_GENERATION_PROVIDER=cliproxy
WEBOT_IMAGE_GENERATION_MODEL=gpt-image-2

# Optional voice transcription fallback. iLink-provided transcripts need no
# extra service. These settings are used only when a voice has no text.
WEBOT_STT_PROVIDER=openai
WEBOT_STT_MODEL=gpt-4o-mini-transcribe
WEBOT_STT_LANGUAGE=zh
# WEBOT_STT_ENDPOINT=audio/transcriptions

# Optional: load a provider file from a non-default path.
# WEBOT_PROVIDERS_FILE=/absolute/path/providers.json
